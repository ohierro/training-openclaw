{
  "name": "presentations",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "copy:assets": "node scripts/copy-assets.mjs",
    "build": "marp --input-dir . --output dist --html && npm run copy:assets",
    "build:watch": "npm run copy:assets && marp --input-dir . --output dist --html --watch",
    "live:01": "npm run build:watch & live-server dist --port=8080 --wait=300 --open=/session01",
    "live:02": "npm run build:watch & live-server dist --port=8080 --wait=300 --open=/session02",
    "pdf:01": "marp session01/index.md --allow-local-files -o session01.pdf",
    "livepreview": "npm run build:watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.3.1",
    "live-server": "^1.2.2"
  }
}
